                  "",
                  "pm.test(\"Response body is an array\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"All posts belong to the filtered user\", () => {",
                  "    const body = pm.response.json();",
                  "    const userId = Number(pm.collectionVariables.get(\"user_id\"));",
                  "    body.forEach(post => {",
                  "        pm.expect(post.userId).to.eql(userId);",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Posts follow the expected schema\", () => {",
                  "    const schema = {",
                  "        type: \"array\",",
                  "        items: {",
                  "            type: \"object\",",
                  "            required: [\"userId\", \"id\", \"title\", \"body\"],",
                  "            properties: {",
                  "                userId: { type: \"number\" },",
                  "                id: { type: \"number\" },",
                  "                title: { type: \"string\" },",
                  "                body: { type: \"string\" }",
                  "            }",
                  "        }",
                  "    };",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 2000ms\", () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ]
              }
