              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"POST returns 201 Created\", () => {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Created post contains expected fields\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property(\"id\");",
                  "    pm.expect(body.title).to.eql(\"QA L3 API Testing\");",
